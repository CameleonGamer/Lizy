{
  "expo": {
    "name": "Lizy",
    "slug": "lizy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lizy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lizy.app"
    },
    "android": {
      "package": "com.lizy.app",
      "versionCode": 17,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Lizy a besoin de l'appareil photo pour scanner le QR Code Pronote."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lizy utilise votre position pour trouver votre établissement scolaire."
        }
      ]
    ]
  }
}
